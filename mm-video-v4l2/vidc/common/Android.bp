cc_library_static {
    name: "libOmxVidcCommon",
    vendor: true,

    srcs: [
        "src/extra_data_handler.cpp",
        "src/vidc_color_converter.cpp",
    ],

    cflags: [
        "-Werror",
        "-D_ANDROID_",
        "-D_ANDROID_ICS_",
    ],

    local_include_dirs: [
        "inc",
    ],

    shared_libs: [
        "liblog",
        "libutils",
        "libcutils",
        "libdl",
        "libhardware",
    ],

    header_libs: [
        "display_headers",
        "generated_kernel_headers",
        "libhardware_headers",
        "media_headers",
        "libc2dcolorconvert_headers",
    ],
}

cc_library_headers {
    name: "libomxcommon_headers",
    vendor: true,
    export_include_dirs: ["inc"],
}
